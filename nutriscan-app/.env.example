# ========================================================
# CẤU HÌNH HỆ THỐNG NUTRISCAN AI (MẪU .env.example)
# Sao chép file này thành .env và điền cấu hình của bạn
# ========================================================

# CÁCH 1 (KHUYÊN DÙNG KHI BUILD FILE APK PHÁT HÀNH RA CÔNG CHÚNG):
# Điền URL của Backend Proxy (thư mục nutriscan-proxy triển khai lên Vercel).
# Khi dùng Proxy, bạn ĐỂ TRỐNG các khóa API bên dưới để trong file .apk không chứa bất kỳ khóa bí mật nào!
EXPO_PUBLIC_API_PROXY_URL=

# CÁCH 2 (CHẠY TEST TRỰC TIẾP TRÊN MÁY / EXPO GO):
# Nhà cung cấp AI mặc định: OPENAI hoặc GEMINI
EXPO_PUBLIC_AI_PROVIDER=OPENAI

# OpenAI API Key (bắt đầu bằng sk-...):
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# (Tùy chọn) Google Gemini API Key:
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
