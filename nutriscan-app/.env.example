# ========================================================
# CẤU HÌNH HỆ THỐNG NUTRISCAN AI (MẪU .env.example)
# Sao chép file này thành .env và điền cấu hình của bạn
# ========================================================

# LỰA CHỌN 1: GitHub Token (Chạy chính thức OpenAI GPT-4o-mini MIỄN PHÍ)
# Lấy tại: https://github.com/settings/tokens/new
EXPO_PUBLIC_GITHUB_TOKEN=

# LỰA CHỌN 2: Groq API Key (Chạy Meta Llama-4 Maverick 17B Vision MIỄN PHÍ)
# Lấy tại: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=

# LỰA CHỌN 3: Đường dẫn kết nối tới Trạm gác bảo mật trên Vercel (Dành cho bản APK):
EXPO_PUBLIC_API_PROXY_URL=https://nutriscan-ai-nutriscan-proxy.vercel.app/api/analyze

EXPO_PUBLIC_AI_PROVIDER=GROQ
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=
