# ========================================================
# CẤU HÌNH HỆ THỐNG NUTRISCAN AI (MẪU .env.example)
# Sao chép file này thành .env và điền API Key của bạn
# ========================================================

# Nhà cung cấp AI mặc định: OPENAI hoặc GEMINI
EXPO_PUBLIC_AI_PROVIDER=OPENAI

# OpenAI API Key (bắt đầu bằng sk-...):
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# (Tùy chọn) Google Gemini API Key:
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

